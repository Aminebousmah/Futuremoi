{% extends "base.html.j2" %}
{% set page_actif = "offres" %}
{% block titre %}Offres — freelance-radar{% endblock %}

{% block contenu %}
<h1>Offres</h1>
<p class="sub">
  {{ offres|length }} offre(s) affichée(s) · profil : {{ profil.name or "non renseigné" }}
  · seuil de candidature : {{ "%.0f"|format(seuil) }}/100
  {% if dernier_passage %}· dernière actualisation le {{ dernier_passage.strftime("%d/%m/%Y à %H:%M") }}{% endif %}
</p>

{% if campagne.error %}
<div class="panneau avert">Dernière campagne en échec : {{ campagne.error }}</div>
{% elif campagne.result %}
<div class="panneau avert">
  Dernière campagne : {{ campagne.result.collectees }} collectées,
  <strong>{{ campagne.result.retenues }}</strong> retenues,
  {{ campagne.result.nouvelles }} nouvelles.
  {% if campagne.result.depuis %}<br><span class="bas">Nouveautés depuis le {{ campagne.result.depuis }}.</span>{% endif %}
  {% if campagne.result.rejets %}<br><span class="bas">Rejets : {{ campagne.result.rejets }}</span>{% endif %}
</div>
{% endif %}

<div class="stats">
  {% for statut, n in par_statut.items() %}
  <div class="stat"><b>{{ n }}</b><span>{{ statut|statut }}</span></div>
  {% endfor %}
</div>

<div class="panneau">
  <form class="enligne" method="get" action="/">
    <label>Score min
      <input type="number" name="score_min" min="0" max="100" step="5"
             value="{{ filtres.score_min|int }}" style="width:5rem">
    </label>
    <label>Statut
      <select name="statut">
        <option value="">tous</option>
        {% for s in statuts %}
        <option value="{{ s }}" {{ 'selected' if filtres.statut == s }}>{{ s|statut }}</option>
        {% endfor %}
      </select>
    </label>
    <label>Source
      <select name="source">
        <option value="">toutes</option>
        {% for s in par_source %}
        <option value="{{ s }}" {{ 'selected' if filtres.source == s }}>{{ s }}</option>
        {% endfor %}
      </select>
    </label>
    <label class="case">
      <input type="checkbox" name="selection" value="true"
             {{ 'checked' if filtres.selection }}> ★ sélection
    </label>
    <label class="case">
      <input type="checkbox" name="ecartees" value="true"
             {{ 'checked' if filtres.ecartees }}> voir les écartées
    </label>
    <button type="submit">Filtrer</button>
    <a class="bouton" href="/">Réinitialiser</a>
  </form>
</div>

<div class="panneau scroll">
  <table>
    <thead>
      <tr><th></th><th>Score</th><th>Mission</th><th>Entreprise</th><th>Lieu</th>
          <th>TJM</th><th>Statut</th><th>Actions</th></tr>
    </thead>
    <tbody>
    {% for o in offres %}
      <tr class="{{ 'ecartee' if o.discarded }}">
        <td>
          <form method="post" action="/offre/{{ o.id }}/selection" class="compact">
            <input type="hidden" name="retour" value="{{ url_courante }}">
            <button type="submit" class="etoile" title="Mettre en sélection"
                    >{{ "★" if o.starred else "☆" }}</button>
          </form>
        </td>
        <td class="score {{ 'haut' if o.score >= seuil else 'bas' }}">{{ "%.0f"|format(o.score) }}</td>
        <td>
          <a href="/offre/{{ o.id }}">{{ o.title }}</a>
          {% if o.notes %}<span title="{{ o.notes }}">📝</span>{% endif %}<br>
          <span class="bas" style="font-size:.76rem">
            {{ o.source }}{% for s in o.skills[:4] %} · {{ s }}{% endfor %}
          </span>
        </td>
        <td>{{ o.company or "—" }}</td>
        <td>{{ o.location or "—" }}<br>
            <span class="bas" style="font-size:.76rem">{{ o.remote.value }}</span></td>
        <td>{{ (o.daily_rate ~ " €") if o.daily_rate else "—" }}</td>
        <td><span class="badge">{{ o.status.value|statut }}</span></td>
        <td class="actions">
          <form method="post" action="/offre/{{ o.id }}/ecarter" class="compact">
            <input type="hidden" name="retour" value="{{ url_courante }}">
            {% if o.discarded %}
            <input type="hidden" name="remettre" value="true">
            <button type="submit" title="Remettre dans la liste">↩</button>
            {% else %}
            <button type="submit" title="Écarter cette offre">✕</button>
            {% endif %}
          </form>
        </td>
      </tr>
    {% else %}
      <tr><td colspan="8" class="bas">
        Aucune offre. Lancez une campagne depuis le bouton en haut à droite.
      </td></tr>
    {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}
