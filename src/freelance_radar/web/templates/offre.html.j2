{% extends "base.html.j2" %}
{% set page_actif = "offres" %}
{% block titre %}{{ offre.title }} — freelance-radar{% endblock %}

{% block contenu %}
<h1>
  {{ offre.title }}
  <form method="post" action="/offre/{{ offre.id }}/selection" class="compact">
    <button type="submit" class="etoile" title="Mettre en sélection"
            >{{ "★" if offre.starred else "☆" }}</button>
  </form>
</h1>
{% if offre.discarded %}
<div class="panneau avert">
  Offre écartée : elle n'apparaît plus dans la liste.
  <form method="post" action="/offre/{{ offre.id }}/ecarter" class="compact">
    <input type="hidden" name="remettre" value="true">
    <button type="submit">↩ la remettre</button>
  </form>
</div>
{% endif %}
<p class="sub">
  <span class="score {{ 'haut' if offre.score >= seuil else 'bas' }}">{{ "%.0f"|format(offre.score) }}/100</span>
  · {{ offre.company or "entreprise non précisée" }}
  · <a href="{{ offre.url }}" target="_blank" rel="noopener">voir l'annonce d'origine</a>
</p>

<div class="panneau">
  <table>
    <tr><th>Lieu</th><td>{{ offre.location or "—" }} ({{ offre.remote.value }})</td></tr>
    <tr><th>Contrat</th><td>{{ offre.contract.value }}</td></tr>
    <tr><th>TJM affiché</th><td>{{ (offre.daily_rate ~ " € HT/j") if offre.daily_rate else "non précisé" }}</td></tr>
    <tr><th>Durée</th><td>{{ (offre.duration_months ~ " mois") if offre.duration_months else "non précisée" }}</td></tr>
    <tr><th>Publiée</th><td>{{ offre.published_at.strftime("%d/%m/%Y") if offre.published_at else "inconnu" }}</td></tr>
    <tr><th>Source</th><td>{{ offre.source }}</td></tr>
    <tr><th>Compétences</th><td>
      {% for s in offre.skills %}<span class="chip">{{ s }}</span>{% else %}—{% endfor %}
    </td></tr>
  </table>
</div>

{% if offre.description_tronquee %}
{# L'angle mort le plus couteux : une competence exigee peut se trouver dans
   la partie que la source ne livre pas. Mieux vaut le dire que laisser
   croire a une lecture complete. #}
<div class="panneau avert">
  <strong>Annonce tronquée par la source</strong>
  <p class="sub" style="margin:.5rem 0 0">
    Seuls {{ offre.description|length }} caractères nous sont livrés — le reste
    n'est pas accessible. Une compétence exigée peut s'y trouver :
    <a href="{{ offre.url }}" target="_blank" rel="noopener">lisez l'annonce
    complète</a>, puis imposez l'outil manquant dans le champ « Imposer » du CV.
  </p>
</div>
{% endif %}

{% if offre.score_detail %}
<div class="panneau">
  <strong>Détail du score</strong>
  <table style="margin-top:.6rem">
    <thead><tr><th>Signal</th><th>Valeur</th><th>Poids</th></tr></thead>
    <tbody>
    {% for signal, poids_signal in poids.items() %}
      {% set v = offre.score_detail.get(signal) %}
      {% if v is number %}
      <tr><td>{{ signal }}</td><td>{{ "%.2f"|format(v) }}</td><td>{{ "%.0f"|format(poids_signal) }}</td></tr>
      {% else %}
      {# Signal muet : retiré du calcul. L'afficher évite de lire un score
         élevé comme une certitude. #}
      <tr class="sub"><td>{{ signal }}</td><td>non renseigné</td><td>{{ "%.0f"|format(poids_signal) }}</td></tr>
      {% endif %}
    {% endfor %}
    </tbody>
  </table>
  {% set couvert = offre.score_detail.get("_poids_couvert") %}
  {% if couvert is number and couvert < 1.0 %}
  <p class="sub" style="margin:.6rem 0 0">
    Score établi sur <strong>{{ "%.0f"|format(couvert * 100) }} %</strong> du poids
    total — les signaux non renseignés sont exclus du calcul, pas comptés à moitié.
  </p>
  {% endif %}
  {% set communes = offre.score_detail.get("_matched_skills") %}
  {% set ecarts = offre.score_detail.get("_missing_skills") %}
  {% if communes %}<p style="margin:.7rem 0 0"><strong class="haut">Recoupement :</strong>
    {% for s in communes %}<span class="chip">{{ s }}</span>{% endfor %}</p>{% endif %}
  {% if ecarts %}<p style="margin:.4rem 0 0"><strong>Écarts :</strong>
    {% for s in ecarts %}<span class="chip">{{ s }}</span>{% endfor %}</p>{% endif %}
</div>
{% endif %}

<div class="panneau">
  <strong>Mes notes</strong>
  <form method="post" action="/offre/{{ offre.id }}/note" style="margin-top:.6rem">
    <textarea name="note" placeholder="Interlocuteur, relance prévue, ce qui vous a plu ou gêné…"
              >{{ offre.notes }}</textarea>
    <p style="margin:.5rem 0 0"><button type="submit">Enregistrer la note</button></p>
  </form>
</div>

<div class="panneau">
  <strong>Candidature</strong>
  {% if candidature %}
    <p class="sub" style="margin:.5rem 0">
      Brouillon généré le {{ candidature.created_at.strftime("%d/%m/%Y à %H:%M") }}
      ({{ candidature.generator }}) · TJM proposé
      <strong>{{ candidature.proposed_rate }} € HT/j</strong>
    </p>
    <p>
      <a class="bouton primaire" style="border:none"
         href="/document/{{ offre.id }}/cv.pdf">CV (PDF)</a>
      <a class="bouton" href="/document/{{ offre.id }}/lettre.md">Lettre</a>
      <a class="bouton" href="/document/{{ offre.id }}/email.md">Email</a>
      <a class="bouton" href="/document/{{ offre.id }}/cv-adapte.md">Note d'adaptation</a>
      <a class="bouton" href="/document/{{ offre.id }}/checklist.md">Checklist</a>
    </p>
    {# Recomposer le seul CV : utile apres avoir touche a profile.yaml, sans
       refaire la lettre et l'email qui n'ont pas bouge. #}
    <form method="post" action="/offre/{{ offre.id }}/cv" class="enligne">
      <input type="text" name="avec" value="{{ imposees }}"
             placeholder="Imposer : DAX, Power Query…"
             style="flex:1;min-width:14rem">
      <button type="submit">Régénérer le CV seul</button>
    </form>
    <p class="bas" style="font-size:.8rem">Dossier : <code>{{ candidature.file_path }}</code></p>
  {% else %}
    <p class="sub" style="margin:.5rem 0">Aucun brouillon pour cette offre.</p>
  {% endif %}

  <p style="margin:.2rem 0 .8rem">
    <a class="bouton primaire" style="border:none" href="/offre/{{ offre.id }}/fiche">
      Fiche de candidature — champs prêts à copier
    </a>
  </p>

  {# Deux chemins distincts, jamais un menu deroulant : le choix par defaut ne
     doit pas pouvoir declencher un appel facture par inadvertance.
     Le champ d'imposition est ICI et pas seulement sur la regeneration :
     autrement il fallait un premier brouillon pour pouvoir choisir, ce qui
     obligeait a generer deux fois. #}
  <form method="post" action="/offre/{{ offre.id }}/candidature">
    <input type="hidden" name="moteur" value="template">
    <label for="avec-{{ offre.id }}" class="sub" style="display:block;margin-bottom:.3rem">
      Compétences à faire figurer coûte que coûte
    </label>
    <div class="enligne">
      <input type="text" id="avec-{{ offre.id }}" name="avec" value="{{ imposees }}"
             placeholder="DAX, Power Query, Microsoft Fabric…"
             style="flex:1;min-width:16rem">
      <button type="submit" class="primaire">
        {{ "Regénérer le brouillon" if candidature else "Générer un brouillon" }}
      </button>
    </div>
  </form>
  <p class="bas" style="font-size:.8rem;margin:.6rem 0 0">
    Séparez par des virgules. Elles passent devant, même si l'annonce ne les
    nomme pas ; le reste du CV se compose sur l'offre, comme d'habitude.
    Hors ligne — rien n'est envoyé, rien n'est facturé.
  </p>

  <p style="margin:.9rem 0 0">
    <a class="bouton" href="/offre/{{ offre.id }}/candidature/confirmer">
      Rédiger avec Claude — appel facturé…
    </a>
  </p>
  <p class="bas" style="font-size:.8rem;margin:.4rem 0 0">
    Demande une confirmation avant d'utiliser votre clé API.
  </p>
</div>

{# Mise en avant au stade entretien, mais accessible a tout moment : on prepare
   souvent avant que le rendez-vous soit cale. #}
<div class="panneau">
  <strong>Entretien</strong>
  {% if offre.status.value == "interview" %}
    <p class="sub" style="margin:.5rem 0">
      Entretien planifié. La fiche liste les questions probables, les points à
      réviser et ce que vous avez à demander.
    </p>
  {% else %}
    <p class="sub" style="margin:.5rem 0">
      Questions probables, points à réviser et questions à poser, déduits de
      l'annonce. Hors ligne, rien n'est facturé.
    </p>
  {% endif %}
  <form method="post" action="/offre/{{ offre.id }}/entretien">
    <button type="submit"
            class="{{ 'primaire' if offre.status.value == 'interview' }}">
      Générer la fiche d'entretien
    </button>
  </form>
</div>

<div class="panneau">
  <div class="enligne" style="margin-bottom:.8rem">
    <form method="post" action="/offre/{{ offre.id }}/postuler" class="compact">
      <button type="submit" class="primaire"
              style="border:none;padding:.45rem .85rem;border-radius:8px;font-size:.85rem">
        J'ai postulé
      </button>
    </form>
    {% if not offre.discarded %}
    <form method="post" action="/offre/{{ offre.id }}/ecarter" class="compact">
      <input type="hidden" name="retour" value="/">
      <button type="submit" style="font-size:.85rem">✕ Écarter cette offre</button>
    </form>
    {% endif %}
  </div>
  <form class="enligne" method="post" action="/offre/{{ offre.id }}/statut">
    <strong style="margin-right:.3rem">Statut</strong>
    <select name="statut">
      {% for s in statuts %}
      <option value="{{ s }}" {{ 'selected' if offre.status.value == s }}>{{ s|statut }}</option>
      {% endfor %}
    </select>
    <button type="submit">Mettre à jour</button>
  </form>
</div>

<div class="panneau">
  <strong>Annonce</strong>
  <pre>{{ offre.description or "(description vide)" }}</pre>
</div>
{% endblock %}
