# --- Generation de candidature par LLM (optionnel) ---
# Sans cle, le generateur bascule automatiquement sur les templates Jinja2.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# --- Adzuna (optionnel, gratuit : https://developer.adzuna.com) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- France Travail / Pole Emploi (optionnel : https://francetravail.io) ---
FRANCE_TRAVAIL_CLIENT_ID=
FRANCE_TRAVAIL_CLIENT_SECRET=

# --- Divers ---
# Identifiez-vous aupres des sites interroges : mettez une adresse ou une URL
# ou l'on peut vous joindre. C'est une politesse, et certains sites en tiennent
# compte avant de bloquer un client automatise.
RADAR_USER_AGENT=freelance-radar/0.1 (+contact: vous@example.com)
